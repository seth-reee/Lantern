pkgname=lantern
pkgver=0.1.1
pkgrel=1
pkgdesc='Qt Quick IP scanner for Omarchy with hostnames and common TCP ports'
arch=('x86_64' 'aarch64')
url='https://github.com/seth-reee/Lantern'
license=('MIT')
depends=('dbus' 'qt6-base' 'qt6-declarative' 'iputils' 'gcc-libs' 'glibc')
optdepends=('qt6-wayland: native Wayland support' 'omarchy: live desktop theme integration')
makedepends=('cmake' 'ninja' 'gcc')
options=('!debug')
# SRCDEST can hold the pinned archive before the release is published.
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('5c06009d68ccf0823e038a51be7dc517596bde47debe52ff97337dffabc8d636')

build() {
  cmake -S "$srcdir/Lantern-$pkgver" -B "build-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=ON
  cmake --build "build-$pkgver" --parallel 2
}

check() {
  ctest --test-dir "build-$pkgver" --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install "build-$pkgver"
}
